// --- XXE --------------------------------------------------------------------------------------

function parseXml($xml) {
    $doc = new DOMDocument();
    // ruleid: php-xxe
    $doc->loadXML($xml, LIBXML_NOENT | LIBXML_DTDLOAD);
    return $doc;
}

function parseXmlSafe($xml) {
    $doc = new DOMDocument();
    // ok: php-xxe
    $doc->loadXML($xml, LIBXML_NONET);
    return $doc;
}
